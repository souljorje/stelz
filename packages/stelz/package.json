{
  "name": "stelz",
  "version": "0.2.1",
  "description": "Standalone persistent Camoufox profiles with exclusive MCP control",
  "license": "MIT",
  "homepage": "https://github.com/souljorje/stelz#readme",
  "bugs": {
    "url": "https://github.com/souljorje/stelz/issues"
  },
  "keywords": ["browser", "automation", "camoufox", "playwright", "mcp", "persistent-profiles"],
  "bin": {
    "stelz": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/supervisor.js",
    "dist/plugin.js",
    "dist/ui/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills/"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/souljorje/stelz.git",
    "directory": "packages/stelz"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@askjo/camofox-browser": "1.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.1",
    "camoufox-js": "0.11.5",
    "hono": "4.13.16",
    "impit": "0.14.8",
    "playwright-core": "1.62.1",
    "stream-json": "3.8.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "bundleDependencies": [
    "@askjo/camofox-browser",
    "camoufox-js"
  ]
}
