{
  "name": "stelz",
  "version": "0.2.0",
  "description": "Standalone persistent Camoufox identities with exclusive MCP control",
  "license": "UNLICENSED",
  "bin": { "stelz": "dist/cli.js" },
  "files": ["dist/cli.js", "dist/supervisor.js", "dist/plugin.js", "docs/", "examples/", "README.md", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=24", "bun": ">=1.3.8" },
  "repository": { "type": "git", "url": "https://github.com/souljorje/stelz.git" },
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "setup": "bun src/cli.ts setup",
    "start": "bun src/cli.ts start",
    "status": "bun src/cli.ts status",
    "stop": "bun src/cli.ts stop",
    "pause": "bun src/cli.ts pause",
    "resume": "bun src/cli.ts resume",
    "mcp": "bun src/cli.ts mcp",
    "browser": "bun src/call.ts",
    "fixture": "bun test/fixture.ts",
    "test": "bun test test/unit.test.ts && bun run test:regression",
    "test:regression": "node --experimental-transform-types --test test/plugin.test.ts test/native-profile.test.ts test/observations.test.ts",
    "test:integration": "bun test/integration.ts",
    "test:native": "bun test/native-integration.ts",
    "test:proxy": "bun test/proxy-integration.ts",
    "test:manual": "bun test/manual-integration.ts",
    "test:package": "bun test/package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@askjo/camofox-browser": "1.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "camoufox-js": "0.11.5",
    "playwright-core": "1.62.1"
  },
  "devDependencies": { "@types/bun": "1.3.8", "typescript": "5.9.3" }
}
