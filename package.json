{
  "name": "stelz-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "pack": "bun scripts/pack.ts",
    "test:prepack": "bun scripts/pack.ts --check-prepack",
    "setup": "bun packages/stelz/src/cli/cli.ts setup",
    "start": "bun packages/stelz/src/cli/cli.ts start",
    "status": "bun packages/stelz/src/cli/cli.ts status",
    "stop": "bun packages/stelz/src/cli/cli.ts stop",
    "pause": "bun packages/stelz/src/cli/cli.ts pause",
    "resume": "bun packages/stelz/src/cli/cli.ts resume",
    "mcp": "bun packages/stelz/src/cli/cli.ts mcp",
    "ui": "bun --no-env-file packages/stelz/src/cli/cli.ts ui",
    "browser": "bun scripts/call.ts",
    "fixture": "bun tests/helpers/fixture.ts",
    "test": "bun test ./tests/unit ./tests/integration && bun run test:regression",
    "test:ui": "bun test tests/integration/catalog-limits.test.ts tests/unit/profile-windows.test.ts tests/unit/ui-server.test.ts tests/integration/ui-model.test.ts tests/integration/profile-configuration.test.ts tests/integration/profile-rename.test.ts tests/unit/ui-api.test.ts tests/unit/ui-display.test.ts",
    "test:ui:browser": "bun tests/browser/ui-browser.ts",
    "test:regression": "node --experimental-transform-types --test tests/regression/*.test.ts",
    "test:integration": "bun tests/browser/integration.ts",
    "test:native": "bun tests/browser/native-integration.ts",
    "test:window-close": "bun tests/browser/window-close.ts",
    "test:windows": "bun --no-env-file tests/browser/profile-windows-browser.ts",
    "test:proxy": "bun tests/browser/proxy-integration.ts",
    "test:manual": "bun tests/qa/manual-integration.ts",
    "test:typing": "bun --no-env-file tests/browser/typing-browser.ts",
    "test:public": "bun --no-env-file tests/qa/public-sites.ts",
    "test:package": "bun tests/qa/package.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/ui",
    "verify:release": "bun scripts/verify-release.ts",
    "test:concurrency": "bun --no-env-file tests/browser/concurrency.ts",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright-core": "1.62.1",
    "@askjo/camofox-browser": "1.18.1"
  },
  "patchedDependencies": {
    "@askjo/camofox-browser@1.18.1": "patches/@askjo%2Fcamofox-browser@1.18.1.patch",
    "camoufox-js@0.11.5": "patches/camoufox-js@0.11.5.patch"
  }
}
