{
  "name": "stelz",
  "version": "0.6.0",
  "description": "Standalone persistent Camoufox profiles with exclusive MCP control",
  "license": "MIT",
  "homepage": "https://github.com/souljorje/stelz#readme",
  "bugs": {
    "url": "https://github.com/souljorje/stelz/issues"
  },
  "keywords": [
    "browser",
    "automation",
    "camoufox",
    "playwright",
    "mcp",
    "persistent-profiles"
  ],
  "bin": {
    "stelz": "src/cli/cli.ts"
  },
  "exports": {
    "./sdk": "./src/sdk/index.ts"
  },
  "files": [
    "src/",
    "dist/plugin.js",
    "dist/ui/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/souljorje/stelz.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "changeset": "changeset",
    "version:packages": "changeset version && bun install --lockfile-only --ignore-scripts",
    "build": "vite build",
    "prepare:package": "bun scripts/prepare-package.ts",
    "setup": "bun src/cli/cli.ts setup",
    "start": "bun src/cli/cli.ts start",
    "status": "bun src/cli/cli.ts status",
    "stop": "bun src/cli/cli.ts stop",
    "pause": "bun src/cli/cli.ts pause",
    "resume": "bun src/cli/cli.ts resume",
    "mcp": "bun src/cli/cli.ts mcp",
    "ui": "bun --no-env-file src/cli/cli.ts ui",
    "browser": "bun scripts/call.ts",
    "lint": "oxlint src ui scripts tests vite.config.ts",
    "lint:package": "publint --strict",
    "typecheck": "tsc --noEmit",
    "check": "bun run --parallel --no-exit-on-error lint typecheck build check:docs test",
    "check:docs": "linkinator README.md CONTRIBUTING.md AGENTS.md 'docs/**/*.md' 'skills/**/*.md' --markdown --skip '^https:'",
    "test": "bun test --parallel ./tests/unit",
    "test:browser": "bun run build && bun --no-env-file tests/browser/smoke.ts",
    "test:ui": "bun run build && bun --no-env-file tests/browser/ui.ts",
    "test:install": "bun tests/qa/install.ts",
    "test:package": "bun --no-env-file tests/qa/package.ts",
    "test:setup": "bun --no-env-file tests/qa/setup.ts",
    "test:proxy": "bun --no-env-file tests/qa/proxy.ts",
    "test:public": "bun --no-env-file tests/qa/public-sites.ts",
    "test:human": "bun tests/qa/human.ts",
    "release": "changeset publish --from-pack-dir release-artifacts"
  },
  "dependencies": {
    "@askjo/camofox-browser": "1.19.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "camoufox": "0.5.9",
    "hono": "4.13.16",
    "playwright-core": "1.62.1",
    "better-sqlite3": "13.0.1",
    "impit": "0.14.8",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "maxmind": "5.0.8"
  },
  "bundleDependencies": [
    "@askjo/camofox-browser"
  ],
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "lefthook": "2.2.2",
    "linkinator": "8.1.0",
    "oxlint": "1.94.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "patchedDependencies": {
    "@askjo/camofox-browser@1.19.0": "patches/@askjo%2Fcamofox-browser@1.19.0.patch"
  }
}
