{
  "name": "stelz",
  "version": "0.2.0",
  "description": "Standalone persistent Camoufox profiles with exclusive MCP control",
  "license": "UNLICENSED",
  "bin": {
    "stelz": "dist/cli.js"
  },
  "files": ["dist/cli.js", "dist/supervisor.js", "dist/plugin.js", "dist/ui/", "docs/", "examples/", "README.md", "THIRD_PARTY_NOTICES.md"],
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/souljorje/stelz.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "setup": "bun src/cli.ts setup",
    "start": "bun src/cli.ts start",
    "status": "bun src/cli.ts status",
    "stop": "bun src/cli.ts stop",
    "pause": "bun src/cli.ts pause",
    "resume": "bun src/cli.ts resume",
    "mcp": "bun src/cli.ts mcp",
    "ui": "bun --no-env-file src/cli.ts ui",
    "browser": "bun src/call.ts",
    "fixture": "bun test/fixture.ts",
    "test": "bun test test/profile-compat.test.ts test/profile-windows.test.ts test/unit.test.ts test/typing.test.ts test/lifecycle.test.ts test/setup.test.ts test/ui-server.test.ts test/ui-model.test.ts test/profile-configuration.test.ts test/public-site-verdicts.test.ts test/rebrowser-verdict.test.ts test/public-sites.test.ts ui/api.test.ts ui/model.test.ts && bun run test:regression",
    "test:ui": "bun test test/profile-windows.test.ts test/ui-server.test.ts test/ui-model.test.ts test/profile-configuration.test.ts ui/api.test.ts ui/model.test.ts",
    "test:ui:browser": "bun test/ui-browser.ts",
    "test:regression": "node --experimental-transform-types --test test/plugin.test.ts test/native-profile.test.ts test/observations.test.ts",
    "test:integration": "bun test/integration.ts",
    "test:native": "bun test/native-integration.ts",
    "test:window-close": "bun test/window-close.ts",
    "test:windows": "bun --no-env-file test/profile-windows-browser.ts",
    "test:proxy": "bun test/proxy-integration.ts",
    "test:manual": "bun test/manual-integration.ts",
    "test:typing": "bun --no-env-file test/typing-browser.ts",
    "test:public": "bun --no-env-file test/public-sites.ts",
    "test:package": "bun test/package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@askjo/camofox-browser": "1.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "camoufox-js": "0.11.5",
    "hono": "4.13.16",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/bun": "1.3.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
