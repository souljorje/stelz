{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Input validation rejects control characters with these expressions.
    "eslint/no-control-regex": "off",
    // Transaction cleanup and the public-site check return from finally on purpose.
    "eslint/no-unsafe-finally": "off"
  }
}
