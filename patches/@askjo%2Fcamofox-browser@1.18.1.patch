diff --git a/lib/stelz-click-guard.js b/lib/stelz-click-guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..8c665a60cb51b44a138a5ff83dd8a5395ad989d2
--- /dev/null
+++ b/lib/stelz-click-guard.js
@@ -0,0 +1,18 @@
+// stelz: Playwright logs "performing click action" once a click attempt sends input.
+// After that point the page may have received the click, so a fallback click could repeat it.
+export function clickReachedPage(error) {
+  return String(error?.message || '').includes('performing click action');
+}
+
+// The DOM fallback rejects a non-HTML element before it clicks. Any other failure may follow the click.
+export function domClickRejected(error) {
+  return String(error?.message || '').includes('Element is not an HTMLElement');
+}
+
+// A conflict without a recovery hint: the caller must observe the page before another action.
+export function uncertainClickError(cause) {
+  const error = new Error('The click may have reached the page, so it was not repeated. Read a fresh snapshot before the next action.');
+  error.statusCode = 409;
+  error.cause = cause;
+  return error;
+}
diff --git a/lib/stelz-page-ownership.js b/lib/stelz-page-ownership.js
new file mode 100644
index 0000000000000000000000000000000000000000..85901c85b9f589dc2a0c198608a4107db4c823cc
--- /dev/null
+++ b/lib/stelz-page-ownership.js
@@ -0,0 +1,13 @@
+// stelz: Camofox creates, registers, and closes its own pages. A person or a website can open
+// other pages in the same headed browser. The orphan page reaper must leave those pages open.
+const owned = new WeakSet();
+
+export function ownPage(page) {
+  if (page) owned.add(page);
+  return page;
+}
+
+// An orphan is a page that Camofox owned and no longer tracks or leases.
+export function isOrphanPage(page, registered, leased) {
+  return owned.has(page) && !registered.has(page) && !leased;
+}
